# Get your Resend API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Sender email - must be a verified domain in Resend or use onboarding@resend.dev for testing
RESEND_FROM_EMAIL=onboarding@resend.dev

# Business notification email - where lead notifications are sent
RESEND_BUSINESS_EMAIL=metaliftsit@gmail.com

# For Vercel deployment, add these in your Vercel project settings:
# Settings > Environment Variables
