# Get your EmailJS credentials from https://www.emailjs.com/
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# EmailJS template should include these variables:
# {{name}} {{email}} {{phone}} {{service}} {{message}}
# Also supported: {{from_name}} {{user_name}} {{user_email}} {{reply_to}} {{user_phone}}

# In EmailJS dashboard, add allowed origins:
# http://localhost:8080
# https://your-live-domain.com
